  "reasons": {
    "timeouts:frontend/playwright.config.ts": "The global-settings project got its own backend and Vite server (start-up tripwires of 60 s each, like the first pair) so its specs run beside the rest instead of after it."
  },
  "single_test_max_s": {
    "ci": 30,
    "local": 10
  },
  "slow_tests": {
    "internal/domain/agent.TestFindAlternatives_ListedWarningsAreTheWritesWarnings": "checks every listed alternative of every draft meal with a dry-run write (21 meals x 10 alternatives); a write that pushes a day over its range runs the lower-instead search (planning.Ways), about 2 CPU-s per meal. Faster needs a Ways that stops at the first fitting way, which changes its ranking.",
    "internal/domain/agent.TestReplayA1": "replays a recorded chat turn by turn over the A1 fixture database, every tool call against the real planner; one goroutine, so it runs in the no-race pass only",
    "internal/domain/agent.TestReplayE048c": "replays the E048c offer over the stored week and dry-runs every way of the day; one goroutine, so it runs in the no-race pass only"
  },
