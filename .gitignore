# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Editor-tooling shims created by `mise run lsp` (LSP servers resolve from repo root)
/node_modules
.mise/locks/

# env file
.env

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*.log

# Vitest run artifacts (updated on every test run, not useful in VCS)
frontend/test-results/
.claude/worktrees/
.worktrees/
.DS_Store

# Generated encryption key (see backend/internal/config EnsureSecretKey)
secret.key

# Offline eval reports (cmd/plantry-eval -out default)
plantry-eval.jsonl

# Live eval run databases (cmd/plantry-eval, PLANTRY_EVAL_LIVE=1)
plantry-eval-dbs/
.claude/skills/impeccable/scripts/bin/

# Python bytecode
__pycache__/
*.pyc

# Local Claude Code settings (may hold tokens)
.claude/settings.local.json

# SQLite databases: only reviewed, secret-free fixtures are tracked
# (guarded by TestFixtureDBsCarryNoCredentials)
*.db
*.sqlite*
!backend/internal/spectest/testdata/*.db
!backend/internal/domain/agent/testdata/*.db
!backend/internal/adapters/sqlite/testdata/*.db
